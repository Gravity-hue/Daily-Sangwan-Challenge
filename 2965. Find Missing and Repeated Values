#include <bits/stdc++.h>
using namespace std;

vector<int> findMissingAndRepeatedValues(vector<vector<int>>& grid) {
        vector<int> ans;
        unordered_set<int>s;
        int a,b;//a=repeated, b=missing
        int n=grid.size();
        int expected_sum=(n*n)*(n*n+1)/2;
        int actual_sum=0;

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                actual_sum+=grid[i][j];
                if(s.find(grid[i][j])!=s.end()){//repeated value found
                    a=grid[i][j];
                    ans.push_back(a);                  
                }else{
                s.insert(grid[i][j]);}
            }
        }
        b=expected_sum-actual_sum+a;
        ans.push_back(b);
        return ans;
}

int main(){
vector<vector<int>>sample={{1,3},{2,2}};
cout<<findMissingAndRepeatedValues(sample);

return 0;}
