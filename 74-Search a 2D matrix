class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int rows=matrix.size();
        int col=matrix[0].size();

        int i=0;//row iterator
        while(i<rows){
        if(target>=matrix[i][0] && target<=matrix[i][col-1]){//selecting perfect row
            int st=0;//column st idx
            int end=col-1;//column end idx

            while(st<=end){
                int mid=(st+end)/2;

                if(matrix[i][mid]==target){return true;}
                else if(matrix[i][mid]<target){
                    st=mid+1;
                }else{
                    end=mid-1;
                }
                
            }
            
        }i++;}
        return false;
    }
};
