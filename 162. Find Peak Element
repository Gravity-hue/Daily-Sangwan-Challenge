class Solution {
public:
    int findPeakElement(vector<int>& nums) {
    int n=nums.size();

    if(nums.size()==1 || nums[0]>nums[1]){//edge case 1&2 
        return 0;
    }
    if(nums[n-1]>nums[n-2]){//edge case 3
        return n-1;
    }

    int low=1;
    int high=n-2;

    while(low<=high){
        int mid=low+(high-low)/2;

        if(nums[mid-1]<nums[mid] && nums[mid]>nums[mid+1]){
            return mid;
        }
        else if(nums[mid-1]<nums[mid]){
            low=mid+1;
        }
        else if(nums[mid]<nums[mid+1]){
            high=mid-1;
        }
        else//when mid at minima
        high=mid-1;
    }
    return -1;
    }
};
