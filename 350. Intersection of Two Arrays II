class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {//Brute
        sort(nums1.begin(),nums1.end());
        sort(nums2.begin(),nums2.end());
        int n1=nums1.size();
        int n2=nums2.size();
        vector<int> ans;
        vector<int> visited(n2,0);//To track the visited element of 2nd array

        for(int i=0; i<n1; i++){//array1
            for(int j=0; j<n2; j++){//array2
                if(nums1[i]==nums2[j] && visited[j]==0){
                    ans.push_back(nums1[i]);
                    visited[j]=1;
                    break;
                }

                if(nums2[j]>nums1[i])break;
            }
        }

        return ans;
        }
    
};
