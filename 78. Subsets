#include <iostream>
#include <vector>
using namespace std;

void getAllSubsets(vector<int>& nums, vector<int>& ans, int i, vector<vector<int>>&subsets){//helper function
        if(i==nums.size()){//basecase
            subsets.push_back({ans});
            return;
        }

        //include
        ans.push_back(nums[i]);
        getAllSubsets(nums,ans,i+1,subsets);

        //exclude, backtracking step
        ans.pop_back();
        getAllSubsets(nums,ans,i+1,subsets);        
    }

vector<vector<int>> subsets(vector<int>& nums) {
        vector<int> ans;
        vector<vector<int>>subsets;

        getAllSubsets(nums, ans, 0, subsets);
        return subsets;        
    }

int main(){
vector<int> sample={1,2,3};
subsets(sample);
return 0;
}
