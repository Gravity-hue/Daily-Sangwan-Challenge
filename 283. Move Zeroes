#include <iostream>
#include <vector>
using namespace std;

void moveZeroes(vector<int>& arr) {
    int n=arr.size();
    int i=0;//2-pointer approach
    int j=i+1;

    while(j<n){
        if(arr[i]==0 && arr[j]!=0){//case1-swap zero with non zero number
            swap(arr[i],arr[j]);
            i++;
            j++;
        }else if(arr[i]==0 && arr[j]==0){//case2-when continuous zero come
            j++;//finds the first non zero after continous zero
        }else{//case3-When only non zero no. coming
            i++;
            j++;
        }
    }
}


int main(){
    vector<int> sample={1,0,2,3,2,0,0,4,5,1};
    int n=sample.size();

    moveZeroes(sample);
    for(int i=0; i<n; i++){
        cout<<sample[i]<<endl;
    }

    return 0;
}
