#include <iostream>
#include <vector>
using namespace std;

//Better
void setZeroesBetter(vector<vector<int>>& matrix){
    int rows=matrix.size();
    int columns=matrix[0].size();
    vector<int> rowZeroCount(rows,0);
    vector<int> columnZeroCount(columns,0);

    for(int i=0; i<rows; i++){
        for(int j=0; j<columns; j++){
            if(matrix[i][j]==0){
                rowZeroCount[i]=1;
                columnZeroCount[j]=1;
            }
        }
    }
    
    for(int i=0; i<rows; i++){
        for(int j=0; j<columns; j++){
            if(rowZeroCount[i]==1 || columnZeroCount[j]==1){
                matrix[i][j]=0;
            }
        }
    }
}



//Optimal
void setZeroesBetterOptimal(vector<vector<int>>& matrix){
    int rows=matrix.size();
    int columns=matrix[0].size();
    int col0=1;

    for(int i=0; i<rows; i++){
        for(int j=0; j<columns; j++){
            if(matrix[i][j]==0){
                matrix[i][0]=0;
            }
            if(j!=0){
                matrix[0][j]=0;
            }
            else
            col0=0;
        }
    }

    for(int i=1; i<rows; i++){
        for(int j=1; j<columns; j++){
            if(matrix[i][j]!=0){
                if(matrix[i][0]==0 || matrix[0][j]==0){
                    matrix[i][j]=0;
                }
            }
        }
    }

    if(matrix[0][0]==0){
        for(int j=1; j<columns; j++){
            matrix[0][j]=0;
        }
    }

    if(col0==0){
        for(int i=0; i<rows; i++){
            matrix[i][0]=0;
        }
    }

}


int main(){
vector<vector<int>> sample={{1,1,1,1},{1,0,0,1},{1,1,0,1}};
setZeroesBetterOptimal(sample);

int row=sample.size();
int column=sample{0}.size();

for(int i=0; i<row; i++){
for(int j=0; j<column; j++{
cout<<sample[i][j]<<" ";}
cout<<endl;}

return 0;
}
