#include <iostream>
#include <vector>
using namespace std;

void rotateMatrix(vector<vector<int>>& matrix) {
        int n=matrix.size();//as n*n matrix
        vector<vector<int>> ans(n, vector<int>(n));

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                int value=matrix[i][j];
                ans[j][n-i-1]=value;
            }
        }

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){//Replacingin original matrix
                matrix[i][j]=ans[i][j];
            }
        }
        
    }

int main(){
vector<vector<int>> sample={{1,2,3},{4,5,6},{7,8,9}};
int n=sample.size();

rotateMatrix(sample);
for(int i=0; i,n; i++){
    for(int j=0; j<n; j++){
     cout<<sample[i][j]<<" ";}
cout<<endl;}

return 0;
}
